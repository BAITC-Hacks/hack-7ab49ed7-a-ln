# Copy to .env and adjust (the one-click launchers do this for you). Every value below is the default.

# Where the web UI listens. 127.0.0.1 keeps it on this machine; set 0.0.0.0 to serve other machines, and only
# together with MG_API_TOKEN.
MG_HTTP_BIND=127.0.0.1
MG_HTTP_PORT=8080

# Access. With a token set, the UI asks for it once and keeps an HttpOnly session cookie;
# scripts can send "Authorization: Bearer <token>". Leave empty only on a trusted network.
MG_API_TOKEN=
MG_SESSION_SECRET=
MG_SESSION_TTL_HOURS=12
MG_COOKIE_SECURE=false
MG_LOGIN_ATTEMPTS_PER_MINUTE=10
# Only when the UI is served from another origin (JSON list, e.g. ["https://aml.example.kz"]).
MG_CORS_ORIGINS=[]

# Upload and dataset limits.
MG_MAX_UPLOAD_MB=200
MG_MAX_ZIP_MEMBERS=20
MG_MAX_ZIP_UNCOMPRESSED_MB=1024
MG_MAX_NODES=500000
MG_MAX_TRANSACTIONS=5000000
# Memory guards checked from parquet footers before a run is accepted: estimated in-memory size of the
# required columns, and nodes × seeds for seed-money tracing (16 bytes per cell while the run is computed).
MG_MAX_DECODED_MB=2048
MG_MAX_TRACE_CELLS=50000000

# Analysis runs. Each run is a separate process with a resident-memory budget (MG_RUN_MEMORY_MB), checked
# periodically: a run found above it is stopped with an error of its own. MG_BACKEND_MEMORY is the hard
# limit of the whole backend container; when it is hit the kernel prefers stopping an analysis process,
# but the API shares the limit and is not guaranteed to survive. Keep
# MG_WORKERS × MG_RUN_MEMORY_MB + ~1.5 GB (API and MG_CACHE_MB) within MG_BACKEND_MEMORY.
MG_BACKEND_MEMORY=8g
MG_RUN_MEMORY_MB=3072
MG_WORKERS=2
MG_JOB_TIMEOUT_S=1800
MG_MAX_ATTEMPTS=2
MG_LEASE_S=60
MG_CACHE_MB=1024
MG_SEED_DEMO=true

# Optional LLM assistant. Off by default: when enabled, graph excerpts for a question are sent to
# the Anthropic API, so enable it only where that data transfer is approved.
MG_LLM_ENABLED=false
MG_ANTHROPIC_API_KEY=
MG_LLM_MODEL=claude-opus-5
MG_LLM_MAX_STEPS=8
MG_LLM_TIMEOUT_S=120

MG_LOG_LEVEL=INFO
MG_LOG_JSON=true
